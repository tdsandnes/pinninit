import numpy as np
import pytest
from coordinate_system import CartesianCoords, CylindricalCoords, SphericalCoords

def test_cartesian_metric_tensor() -> None:
    cs = CartesianCoords(3)
    g = cs.metric_tensor()
    g_actual = np.eye(3)
    assert g_actual == pytest.approx(g)

def test_cylindrical_metric_tensor() -> None:
    cs = CylindricalCoords(3)
    coords = np.array([2.0, 0.5, 1.0])
    g = cs.metric_tensor(coords)
    g_actual = np.array([[1.0, 0.0, 0.0],
                         [0.0, 4.0, 0.0],
                         [0.0, 0.0, 1.0]])
    assert g_actual == pytest.approx(g)

def test_spherical_metric_tensor() -> None:
    cs = SphericalCoords(3)
    coords = np.array([2.0, np.pi / 4, np.pi / 3])
    g = cs.metric_tensor(coords)
    g_actual = np.array([[1.0, 0.0, 0.0],
                         [0.0, 4.0, 0.0],
                         [0.0, 0.0, 2.0]])
    assert g_actual == pytest.approx(g)


@pytest.mark.parametrize("cls, dim", [
    (CartesianCoords, 4),
    (CartesianCoords, 5),
    (CylindricalCoords, 1),
    (CylindricalCoords, 3),
    (SphericalCoords, 1),
    (SphericalCoords, 2),
])
def test_invalid_dimensions(cls, dim: int) -> None:
    with pytest.raises(ValueError):
        cls(dim)
